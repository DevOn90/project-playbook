# ============================================================
# 11. Validate rule "Require a pull request before merging"
# ============================================================

validate_rule_pull_request() {

    log_info "Validating rule 'Require a pull request before merging'"

    # Validate the rule "Require a pull request before merging" is enabled
    if [[ "$(gh api \
        repos/${GITHUB_REPO_FULL_NAME}/rulesets/${ruleset_id} \
        --jq '.rules[] | select(.type == "pull_request") | .type')" == "pull_request" ]];then
        log_info "✅ Rule 'Require a pull request before merging' is enabled as expected"
    else
        log_error "Rule 'Require a pull request before merging' is disabled, but it should be enabled"
        exit 1
    fi 

    # Validate PR detail - required approvers is equal to 1
    if [[ "$(gh api \
            "repos/${GITHUB_REPO_FULL_NAME}/rulesets/${ruleset_id}" \
            --jq '.rules[] | select(.type == "pull_request") | .parameters.required_approving_review_count')" == "1" ]];then
        log_info "✅ Rule 'Require a pull request before merging' has set '1' required approver as expected"
    else
        log_error "Rule 'Require a pull request before merging' has not set '1' required approver, but it should be set to '1'"
        exit 1
    fi

    # Validate PR detail - dismiss stale reviews is enabled
    if [[ "$(gh api repos/${GITHUB_REPO_FULL_NAME}/rulesets/${ruleset_id} --jq '.rules[] | select(.type == "pull_request") | .parameters.dismiss_stale_reviews_on_push')" == "true" ]]; then
        log_info "✅ Rule 'Require a pull request before merging' has 'dismiss stale reviews on push' enabled as expected"
    else
        log_error "Rule 'Require a pull request before merging' has 'dismiss stale reviews on push' disabled, but it should be enabled"
        exit 1
    fi

    # Validate PR detail - Require review from specific teams is disabled
    if [[ "$(gh api \
            repos/${GITHUB_REPO_FULL_NAME}/rulesets/${ruleset_id} \
            --jq '.rules[] | select(.type == "pull_request") | .parameters.required_reviewers | length')" == "0" ]]; then
    log_info "✅ Rule 'Require review from specific teams' has no teams set as expected."
    else
    log_error "Rule 'Require review from specific teams' is enabled, but it should be disabled."
    fi

    # Validate PR detail - Require review from Code Owners is disabled
    if [[ "$(gh api \
            repos/${GITHUB_REPO_FULL_NAME}/rulesets/${ruleset_id} \
            --jq '.rules[] | select(.type == "pull_request") | .parameters.require_code_owner_review')" == "false" ]];then
        log_info "✅ Rule 'Require review from Code Owners' is disabled as expected"
    else
        log_error "Rule 'Require review from Code Owners' is enabled, should be disabled"
    fi

    # Validate PR detail - Require approval of the most recent reviewable push is enabled
    if [[ "$(gh api \
            repos/${GITHUB_REPO_FULL_NAME}/rulesets/${ruleset_id} \
            --jq '.rules[] | select(.type == "pull_request") | .parameters.require_last_push_approval')" == "true" ]]; then
        log_info "✅ Rule 'Require approval of the most recent reviewable push' is enabled as expected"
    else
        log_error "Rule 'Require approval of the most recent reviewable push' is disabled, but it should be enabled"
        exit 1
    fi

    # Validate PR detail - Require conversation resolution before merging is enabled
    if [[ "$(gh api \
                repos/${GITHUB_REPO_FULL_NAME}/rulesets/${ruleset_id} \
                --jq '.rules[] | select(.type == "pull_request") | .parameters.required_review_thread_resolution')" == "true" ]]; then
        log_info "✅ Rule 'Require conversation resolution before merging' is enabled as expected"
    else
        log_error "Rule 'Require conversation resolution before merging' is disabled, but it should be enabled"
        exit 1
    fi

    # Validate PR detail - Allowed merge methods is set to 'Squash' ONLY`
    if [[ "$(gh api \
            repos/${GITHUB_REPO_FULL_NAME}/rulesets/${ruleset_id} \
            --jq '.rules[] | select(.type == "pull_request") | .parameters.allowed_merge_methods.[]')" == "squash" ]]; then
        log_info "✅ Allowed merge method is set to 'Squash' as expected"
    else
        log_error "Allowed merge method is not set to 'Squash' ONLY, but it should be"
        exit 1
    fi

}

# ============================================================
# 12. Validate rule "Require status checks to pass"
# ============================================================

validate_rule_checks_to_pass() {

    log_info "Validating rule 'Require status checks to pass'"

    # Validate the rule "Require status checks to pass" is enabled
    if [[ "$(gh api \
            repos/${GITHUB_REPO_FULL_NAME}/rulesets/${ruleset_id} \
            --jq '.rules[] | select(.type == "required_status_checks") | .type')" == "required_status_checks" ]]; then
        log_info "✅ Rule 'Required status checks' is enabled as expected"
    else
        log_error "Rule 'Required status checks' is not enabled, but it should be"
        exit 1
    fi

    # Validate the rule "Require branches to be up to date before merging"
    if [[ "$(gh api \
            repos/${GITHUB_REPO_FULL_NAME}/rulesets/${ruleset_id} \
            --jq '.rules[] | select(.type == "required_status_checks") | .parameters.strict_required_status_checks_policy')" == "true" ]];then
        log_info "✅ Rule 'Require branches to be up to date before merging' is enabled as expected"
    else
        log_error "Rule 'Require branches to be up to date before merging' is not enabled, but it should be"
        exit 1
    fi

    # Validate the rule "Do not require status checks on creation"
    if [[ "$(gh api \
            repos/${GITHUB_REPO_FULL_NAME}/rulesets/${ruleset_id} \
            --jq '.rules[] | select(.type == "required_status_checks") | .parameters.do_not_enforce_on_create')" == "false"  ]];then
        log_info "✅ Rule 'Do not require status checks on creation' is disabled as expected"
    else
        log_error "Rule 'Do not require status checks on creation' is enabled, but it should be disabled"
        exit 1
    fi

    # Validate status checks are available and list them
    status_checks_count="$(gh api \
                            repos/"$GITHUB_REPO_FULL_NAME"/rulesets/"$ruleset_id" \
                            --jq '.rules[] | select(.type == "required_status_checks") | .parameters.required_status_checks | length')"
    
    if [[ "$status_checks_count" -gt 0 ]]; then
        log_info "✅ Status checks found for the ruleset"
        # List the status checks
        ruleset_title="$(gh api repos/"$GITHUB_REPO_FULL_NAME"/rulesets/"$ruleset_id" --jq '.name')"
        log_info "Listing the status checks for the ruleset: $ruleset_title"
        gh api \
        repos/"$GITHUB_REPO_FULL_NAME"/rulesets/"$ruleset_id" \
        --jq '.rules[] | select(.type == "required_status_checks") | .parameters.required_status_checks[] | .context'
    else
        log_warning "No checks found for the ruleset, but the ruleset must have at least one check to be valid. Please add a check to the ruleset."
    fi

}

