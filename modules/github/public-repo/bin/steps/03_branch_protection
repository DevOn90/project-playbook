        log_info "✅ Rule 'Require code scanning results' is enabled as expected."
    else
        log_error "Rule 'Require code scanning results' is disabled. Enable it before continuing."
        exit 1
    fi

    # Validate alerts threshold is set to 'Errors'
    if [[ "$(gh api \
            repos/${GITHUB_REPO_FULL_NAME}/rulesets/${ruleset_id} \
            --jq '.rules[] | select(.type == "code_scanning") | .parameters.code_scanning_tools[] | .alerts_threshold')" == "errors" ]];then
        log_info "✅ Rule code scanning 'Alerts threshold' is set to 'Errors', as expected."
    else
        log_warning "Rule code scanning 'Alerts threshold' is NOT set to 'Error'. Consider selecting appropriate level."
    fi

    # Validate security alerts threshold is set to 'High or higher'
    if [[ "$(gh api repos/${GITHUB_REPO_FULL_NAME}/rulesets/${ruleset_id} --jq '.rules[] | select(.type == "code_scanning") | .parameters.code_scanning_tools[] | .security_alerts_threshold')" == "high_or_higher" ]];then
       log_info "✅ Rule code scanning 'Security Alerts threshold' is set to 'High or higher', as expected."
    else
       log_warning "Rule code scanning 'Security Alerts threshold' is NOT set to 'High or higher' as recommended. Consider selecting appropriate level." 
    fi
}

