#!/usr/bin/env bash

# ============================================================
# Purpose: This script is collection of functions to configure branch protection rules for a public repository
# Content:
#          1. Configure main branch protection rules
# ------------------------------------------------------------
#          2. Validate enforcement status of the main branch protection ruleset
#          3. Validate bypass actor
#          4. Validate main branch is the only target branch
#          5. Validate rule "Restrict creations"
#          6. Validate rule "Restrict updates"
#          7. Validate rule "Restrict deletions"
#          8. Validate rule "Require linear history"
#          9. Validate rule "Require deployments to succeed"
#          10. Validate rule "Require signed commits"
#          11. Validate rule "Require a pull request before merging"
#          12. Validate rule "Require status checks to pass"
#          13. Validate rule "Block force pushes"
#          14. Validate rule "Require code scanning results"
#          15. Validate rule "Require code quality results"
#          16. Validate rule "Restrict code coverage"
#          17. Validate rule "Automatically request Copilot code review"
# ============================================================

set -euo pipefail

# ============================================================
# 1. Configure main branch protection rules
# ============================================================

configure_main_branch_protection_rules() {

    log_info "Configuring main branch protection rules..."

    log_info "Validate that no ruleset exists"

    ruleset_count=$(gh api --method GET "repos/${GITHUB_REPO_FULL_NAME}/rulesets"  --jq '. | length')

    if [[ "$ruleset_count" -eq 0 ]]; then
        log_info "No existing rulesets found"
    else
        log_error "Existing rulesets found"
        log_error "Please check the existing rulesets and resolve them before re-running this script"
        exit 1
    fi

    # Create a new ruleset for the main branch
    log_info "Creating a new ruleset for the main branch"

    # Validate that the ruleset file exists
    if [[ ! -f "${MODULE_ROOT}/public-repo/templates/rulesets/ruleset-branch-main.json" ]]; then
        log_error "Ruleset file '${MODULE_ROOT}/public-repo/templates/rulesets/ruleset-branch-main.json' not found"
        exit 1
    fi

    local response
    
    response="$(gh api \
    --method POST \
    repos/${GITHUB_REPO_FULL_NAME}/rulesets \
    --input "${MODULE_ROOT}/public-repo/templates/rulesets/ruleset-branch-main.json")"

    if [[ -n "$response" ]]; then
        log_info "Ruleset created successfully"
    else
        log_error "Failed to create ruleset"
        exit 1
    fi
}

# ============================================================
# 2. Validate enforcement status of the main branch protection ruleset
# ============================================================

validate_enforcement_status() {
    
    log_info "Validating enforcement status of the main branch protection ruleset..."

    # Get the ruleset ID for the main branch protection ruleset
    ruleset_id=$(
        gh api \
        --method GET \
        "repos/${GITHUB_REPO_FULL_NAME}/rulesets" \
        --jq '.[] | select(.name == "branch-main-protection") | .id'
    )

    # Validate enforcement status
    if [[ "$(gh api --method GET "repos/${GITHUB_REPO_FULL_NAME}/rulesets/${ruleset_id}" --jq '.enforcement')" == "active" ]];then
        log_info "✅ Main branch protection ruleset is active"
    else
        log_error "Main branch protection ruleset is not active"
        exit 1
    fi
}

# ============================================================
# 3. Validate bypass actor
# ============================================================

validate_bypass_actor() {

    log_info "Validating bypass actor for the main branch protection ruleset..."

    # Validate the bypass actor is 'Me'
    # Get repo owner id (my id)
    my_id=$(gh api repos/${GITHUB_REPO_FULL_NAME} --jq '.owner.id')

    # Check if there is only single bypass actor and his id is equal to repo owner id (my id)
    if [[ "$(gh api \
        --method GET "repos/${GITHUB_REPO_FULL_NAME}/rulesets/${ruleset_id}" \
        --jq '.bypass_actors | length')" -eq "1" \
        && "$(gh api \
        --method GET "repos/${GITHUB_REPO_FULL_NAME}/rulesets/${ruleset_id}" \
        --jq '.bypass_actors[] | .actor_id')" -eq "$my_id" ]];then
        log_info "✅ Bypass actor is correctly set to the authenticated user"
    else
        log_error "Bypass actor is not correctly set to the authenticated user"
        exit 1
    fi
}

# ============================================================
# 4. Validate main branch is the only target branch
# ============================================================

is_main_only_target_branch() {

    log_info "Validating that main branch is the only target branch"

    # Validate that target branch is 'main' only and no other branches are included or excluded
    if [[ "$(gh api \
        --method GET repos/${GITHUB_REPO_FULL_NAME}/rulesets/${ruleset_id} \
        --jq '.conditions.ref_name.include | length')" -eq "1" \
        && "$(gh api \
        --method GET repos/${GITHUB_REPO_FULL_NAME}/rulesets/${ruleset_id} \
        --jq '.conditions.ref_name.include[]')" == "refs/heads/main" \
        && "$(gh api \
        --method GET repos/${GITHUB_REPO_FULL_NAME}/rulesets/${ruleset_id} \
        --jq '.conditions.ref_name.exclude | length')" -eq "0" ]];then
        log_info "✅ Target branch is correctly set to 'main' only"
    else
        log_error "Target branch is not correctly set to 'main only' or may include/exclude other branches"
        exit 1
    fi
}

