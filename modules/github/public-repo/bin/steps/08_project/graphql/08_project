#!/usr/bin/env bash

set -euo pipefail

# ============================================================
# Purpose: This script is collection of functions to create and configure
#          a new project in a public repository.
# Content:
#           0. Source the helper scripts
#           1. Create a new project
#           2. Link the project to the repository
#           3. Set project default repository
#           4. Get project ID
#           5. Create custom field Start Date
#           6. Create custom field Target Date
#           7. Create custom field Point Estimate
#           8. Create custom field Sprint
#           9. Update view fields in project view
#           10. Create a new view in the project (valid for Table & Board view types)
#           11. Create a new Roadmap view in the project (valid for Roadmap view type)
# ============================================================

# ============================================================
# 0. Source the helper scripts
# ============================================================

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# Source the helper scripts
source "$SCRIPT_DIR/08_helpers"


# ============================================================
# 1. Create a new project
# ============================================================

create_new_project() {

    log_info "Creating a new project in the repository..."
    
    local project_name
    
    # 1. Get the project name from the user and validate if not empty
    echo ""
    read -r -p "Enter the name of the new Github project: " project_name
    echo ""

    # 1.1 Validate if the project name is not empty
    if [[ -z "$project_name" ]]; then
        read -r -p "Project name cannot be empty. Please enter a valid project name: " project_name
        if [[ -z "$project_name" ]]; then
            log_error "Project name cannot be empty. Exiting..."
            exit 1
        fi
    fi

    # 3. Prompt for unique project title
    prompt_for_unique_project_title "$project_name"
    
    # 4. Create the project with the provided name and title
    create_project "$project_name" "$PROJECT_TITLE"  # The PROJECT_TITLE variable is set in the prompt_for_unique_project_title function

    # 5. Get project number and export it as an environment variable for use in other scripts
    export PROJECT_NUMBER=$(gh project list \
                              --format json \
                              --jq ".projects[] | select(.title == \"$PROJECT_TITLE\") | .number")


    # Unset the PROJECT_TITLE variable to avoid conflicts with other scripts
    unset PROJECT_TITLE
}

# ============================================================
# 2. Link the project to the repository
# ============================================================

link_project_to_repository() {

    local project_number="$1"
    local repository_name
    local username="$(gh api user --jq '.login' 2>/dev/null)"

    log_info "Linking the project to the repository..."

    # 1. Prompt for the repository name and validate if not empty
    repository_name="$(prompt_to_select_repository)"

    if gh project link "$project_number" \
               --owner "$username" \
               --repo "$repository_name" > /dev/null 2>&1; then
       
       log_info "Project linked to the repository $repository_name successfully."
    else
       log_error "Failed to link the project to the repository $repository_name."
       exit 1
    fi   
}

# ============================================================
# 3. Set project default repository
# ============================================================

set_project_default_repository() {

    log_info "Setting a default repository for the project..."

    # Currently, there is no public GraphQL mutation available to create
    # a default repository for a project on Github. 
    # This function serves as a placeholder for future implementation 
    # when such a mutation becomes available.

    log_warning "Public GraphQL 'mutation' to create a default repository is not available on Github."
    log_warning "As a workaround, you can create a default repository manually in the Github UI."
}

# ============================================================
# 4. Get project ID
# ============================================================

get_project_id() {

    log_info "Getting the project ID..." >&2
    local project_number="$1"

    project_id="$(gh project list \
        --format json \
        --jq ".projects[] | select(.number == $project_number) | .id")"

    echo "$project_id"
}

# ============================================================
# 5. Create custom field Start Date
# ============================================================

create_custom_field_start_date() {

    log_info "Creating custom fields Start Date..."

    local project_id="$1"
    local output
    local field_name="Start Date"
    local field_data_type="DATE"

    output="$(gh api graphql \
        -f query='
        mutation CreateStartDateField($projectId: ID!, $name: String!, $dataType: ProjectV2CustomFieldType!) {
            createProjectV2Field(
                input:  {
                projectId: $projectId
                name: $name
                dataType: $dataType
                }  
            ) {
                projectV2Field {
                    ... on ProjectV2Field {
                        id
                        name
                        dataType
                    }
                }
            }
        }
        ' \
        -F projectId="$project_id" \
        -F name="$field_name" \
        -F dataType="$field_data_type"
        )"

    # Validate if the custom field name is "Start Date" in the output
    if [[ "$(echo "$output" | jq -r ".data.createProjectV2Field.projectV2Field.name")" == "Start Date" ]]; then
        log_info "Custom field 'Start Date' created successfully."
    else
        log_error "Failed to create custom field 'Start Date'."
        exit 1
    fi

    # Validate if the custom field data type is "DATE" in the output
    if [[ "$(echo "$output" | jq -r ".data.createProjectV2Field.projectV2Field.dataType")" == "DATE" ]]; then
        log_info "Custom field 'Start Date' has the correct data type $field_data_type."
    else
        log_error "Custom field 'Start Date' does not have the correct data type '$field_data_type'."
        exit 1
    fi
}

