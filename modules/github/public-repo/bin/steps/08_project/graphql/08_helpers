        log_error "Project number $project_number does not correspond to an existing project."
        exit 1
    fi

    # Validate that the project view name is not empty
    if [[ -z "$project_view_name" ]]; then
        log_error "Project view name is empty. Please provide a valid project view name."
        exit 1
    fi

    response="$(gh api graphql \
        -f query='
        query GetProjectViews($login: String!, $number: Int!) {
            user(login: $login) {
                projectV2(number: $number) {
                    views(first: 20) {
                        nodes {
                            id
                            name
                            number
                            layout
                        }
                    }
                }
            }
        }
        ' \
        -F login="$(gh api user --jq '.login')" \
        -F number="$project_number" \
        | jq -r ".data.user.projectV2.views.nodes[] | select(.name == \"$project_view_name\")"
    )"   
 
    if [[ -n "$response" ]]; then
         return 0
     else
         return 1
    fi
}