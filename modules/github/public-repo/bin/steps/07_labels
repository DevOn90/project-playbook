#!/usr/bin/env bash

# ============================================================
# Purpose: This is collection of script/s managing GitHub repo labels   
# Content: 1. Support functions to create labels
#          2. Remove existing labels 
#          3. Create priority labels
#          4. Create type labels
#          5. Create area labels
#          6. Create dependabot labels
# ============================================================
set -euo pipefail

# ============================================================
# 1. Support functions to create labels
# ============================================================

create_or_update_label() {
  local name="$1"
  local color="$2"
  local description="$3"

  log_info "Processing label: $name"

  if gh api \
      "repos/${GITHUB_USERNAME}/${GITHUB_REPO_NAME}/labels/${name}" \
      >/dev/null 2>&1; then
  

    gh api \
      --method PATCH \
      "repos/${GITHUB_USERNAME}/${GITHUB_REPO_NAME}/labels/${name}" \
      -f new_name="$name" \
      -f color="$color" \
      -f description="$description" \
      >/dev/null

    echo "  Updated"
  else
    gh api \
      --method POST \
      "repos/${GITHUB_USERNAME}/${GITHUB_REPO_NAME}/labels" \
      -f name="$name" \
      -f color="$color" \
      -f description="$description" \
      >/dev/null

    echo "  Created"
  fi
}

# ============================================================
# 2. Remove existing labels
# ============================================================

remove_existing_labels() {
  log_info "Removing existing labels..."
  # Read label names line-by-line to avoid word-splitting and handle empty
  # output gracefully. Use gh label delete which accepts names with spaces.
  while IFS= read -r label; do
    [ -z "${label:-}" ] && continue
    gh label delete "$label" --repo "${GITHUB_USERNAME}/${GITHUB_REPO_NAME}" --yes >/dev/null
    log_info "Removed label: $label"
  done < <(gh api "repos/${GITHUB_USERNAME}/${GITHUB_REPO_NAME}/labels" --jq '.[].name' || true)
}

# ============================================================
# 3. Create priority labels
# ============================================================

create_priority_labels() {
  log_info "Creating priority labels..."
  create_or_update_label "low" "0E8A16" "Low Priority"
  create_or_update_label "moderate" "DBAB09" "Moderate Priority"
  create_or_update_label "high" "B60205" "High Priority"
  create_or_update_label "critical" "D93F0B" "Critical Priority"
}

